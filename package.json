{
  "name": "mushroom-mentor",
  "version": "0.1.0",
  "description": "Coding rules that keep generated code clear, changeable, and honest about why",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "coding-rules",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taso20/mushroom-mentor.git"
  },
  "homepage": "https://github.com/taso20/mushroom-mentor#readme",
  "bugs": {
    "url": "https://github.com/taso20/mushroom-mentor/issues"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "rules",
    "LICENSE",
    "README.md",
    "README.ja.md"
  ],
  "scripts": {
    "check": "biome check . && rumdl check .",
    "check:write": "biome check --write .",
    "check:md": "rumdl check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "npm run check && tsc --noEmit && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
